# Flow State — Environment Variables Template
# Copy this file to .env.local and fill in your actual Supabase credentials.
# NEVER commit .env.local to Git!

# ==========================================
# Supabase Configuration (Required)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Note: Rate limiting is handled in-memory (sliding window) on the server.
# No Upstash Redis credentials required.

# Server-only secrets (Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
CRON_SECRET=your-random-cron-secret-token-here

# ==========================================
# Canonical site origin (server-side trust anchor cho auth redirect)
# ==========================================
# KHÔNG có dấu / ở cuối. Dùng cho resolveNextTarget + Supabase redirectTo.
# Vercel: set cho Production + Preview + Development. Thiếu ở production
# thì callback fallback về request origin + log error (xem lib/auth/redirect.ts).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

