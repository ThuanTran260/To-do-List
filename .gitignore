# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Stitch MCP API Key
.vscode/mcp.json

# Temporary AI Agent working directories (preserve AGENTS.md and skills/)
.agents/*
!.agents/AGENTS.md
!.agents/skills/

# Local notes, working docs & reference libraries (not part of public codebase)
/docs/local/
/docs/superpowers/
/design-md/
/frontend.md
/fix.md
/NEXTJS_PREFETCH_BUG_REPORT.md
